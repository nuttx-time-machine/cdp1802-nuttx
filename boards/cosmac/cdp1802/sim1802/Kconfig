#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_SIM1802

choice
	prompt "Memory profile"
	default BOARD_SIM1802_PROFILE_HW32

config BOARD_SIM1802_PROFILE_HW32
	bool "HW32/32: 32 KiB ROM at 0x0000, 32 KiB RAM at 0x8000"
	---help---
		The layout of a typical real COSMAC board.  The ROM image
		(nuttx.bin) must fit in 32 KiB.  Used for feasibility judgements.

config BOARD_SIM1802_PROFILE_SIM64
	bool "SIM64: ROM image from 0x0000, RAM for the rest of 64 KiB"
	---help---
		Development profile: the ROM is exactly as large as the image
		and everything above it is RAM.

endchoice # Memory profile

config BOARD_SIM1802_CLOCK_HZ
	int "Nominal CPU clock (Hz)"
	default 4000000
	---help---
		The simulator has no clock; this value converts time into
		machine cycles (8 clock periods each) for the cycle-driven
		timer and into time for measurements.

endif # ARCH_BOARD_SIM1802
