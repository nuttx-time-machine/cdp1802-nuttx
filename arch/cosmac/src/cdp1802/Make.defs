# Reset code: must be linked first, at the reset vector 0x0000

HEAD_ASRC = cdp1802_head.S

# Common COSMAC files

CMN_ASRCS  = cosmac_irqentry.S cosmac_irqsave.S cosmac_ncrt.S
CMN_ASRCS += cosmac_doswitch.S
CMN_CSRCS  = cosmac_allocateheap.c cosmac_checkstack.c cosmac_createstack.c
CMN_CSRCS += cosmac_div64.c
CMN_CSRCS += cosmac_doirq.c cosmac_exit.c cosmac_initialize.c
CMN_CSRCS += cosmac_initialstate.c cosmac_irq.c cosmac_nputs.c
CMN_CSRCS += cosmac_registerdump.c cosmac_stackframe.c cosmac_stubs.c
CMN_CSRCS += cosmac_switchcontext.c

ifeq ($(CONFIG_ENABLE_ALL_SIGNALS),y)
CMN_CSRCS += cosmac_schedulesigaction.c cosmac_sigdeliver.c
endif

ifneq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CMN_CSRCS += cosmac_idle.c
endif

ifeq ($(CONFIG_COSMAC_BANKING),y)
CMN_ASRCS += cosmac_farcall.S
CMN_CSRCS += cosmac_banking.c
endif

# CDP1802 chip files

CHIP_ASRCS =
CHIP_CSRCS =
