# Toolchain: mikpe's cdp1802-elf GCC/binutils, built by the meta repo's
# toolchain/build-toolchain.sh (C only, soft-float, patched for
# interrupt-safe stack pointer updates, ADR 0007).  The tools are on PATH
# via scripts/env.sh as both cdp1802-unknown-elf-* and cdp1802-elf-*.

CROSSDEV ?= cdp1802-elf-

ARCHCPUFLAGS = -march=1802

# Size is the main risk of this port: optimise for size

ifeq ($(CONFIG_DEBUG_CUSTOMOPT),y)
  ARCHOPTIMIZATION += $(CONFIG_DEBUG_OPTLEVEL)
else ifeq ($(CONFIG_DEBUG_FULLOPT),y)
  ARCHOPTIMIZATION += -Os
endif

ifeq ($(CONFIG_DEBUG_SYMBOLS),y)
  ARCHOPTIMIZATION += $(CONFIG_DEBUG_SYMBOLS_LEVEL)
endif

ifeq ($(CONFIG_DEBUG_OPT_UNUSED_SECTIONS),y)
  LDFLAGS          += --gc-sections
  ARCHOPTIMIZATION += -ffunction-sections -fdata-sections
endif

ifeq ($(CONFIG_DEBUG_LINK_MAP),y)
  LDFLAGS += -Map=$(call CONVERT_PATH,$(TOPDIR)$(DELIM)nuttx.map)
endif

ifneq ($(CONFIG_DEBUG_NOOPT),y)
  ARCHOPTIMIZATION += -fno-strict-aliasing
endif

ARCHOPTIMIZATION += -fomit-frame-pointer

ARCHCFLAGS += -fno-common
ARCHCFLAGS += -Wall -Wstrict-prototypes -Wshadow -Wundef -Wno-attributes -Wno-unknown-pragmas

LDFLAGS += -nostdlib

CC = $(CROSSDEV)gcc
CPP = $(CROSSDEV)gcc -E -P -x c
LD = $(CROSSDEV)ld
STRIP = $(CROSSDEV)strip --strip-unneeded
AR = $(CROSSDEV)ar rcs
UNAR = $(CROSSDEV)ar x
NM = $(CROSSDEV)nm
OBJCOPY = $(CROSSDEV)objcopy
OBJDUMP = $(CROSSDEV)objdump

# libgcc (GPL with the GCC Runtime Library Exception) provides the NCRT
# helpers for 32/64-bit arithmetic and soft-float.  It is built without any
# target libc headers (ADR 0004).

EXTRA_LIBS += $(wildcard $(shell $(CC) $(ARCHCPUFLAGS) --print-libgcc-file-name))
