#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_COSMAC
comment "COSMAC Options"

choice
	prompt "COSMAC chip selection"
	default ARCH_CHIP_CDP1802

config ARCH_CHIP_CDP1802
	bool "RCA CDP1802"
	select MM_SMALL
	select LIBC_ATOMIC_IRQ
	---help---
		RCA CDP1802 COSMAC 8-bit microprocessor (compiled with
		cdp1802-elf-gcc -march=1802).

endchoice # COSMAC chip selection

config ARCH_CHIP
	string
	default "cdp1802" if ARCH_CHIP_CDP1802

choice
	prompt "Interrupt enable state"
	default COSMAC_IRQSTATE_LSIE

config COSMAC_IRQSTATE_LSIE
	bool "Read IE with LSIE"
	---help---
		up_irq_save() reads the hardware IE flip-flop with the LSIE
		instruction (long skip if IE=1) and changes it with DIS/RET, like
		the other NuttX ports that read their hardware interrupt state.

config COSMAC_IRQSTATE_SWFLAG
	bool "Software interrupt-enable flag"
	---help---
		Keep a copy of IE in RAM (g_cosmac_ie) instead of reading it
		with LSIE.  up_irq_save/restore/enable and the interrupt entry and
		exit keep the copy equal to IE; changing IE still takes DIS/RET.

endchoice # Interrupt enable state

config COSMAC_BANKING
	bool
	default n
	---help---
		Code banking (selected by the board's memory profile): a 16 KiB
		window at 0x8000 shows one bank of a larger ROM, selected by a
		write-only latch on an output port.  Objects are placed in banks by
		tools/cosmac/cosmac_bank.py at link time; calls between regions go
		through stubs in fixed ROM and the far-call trampoline
		(arch/cosmac/src/common/cosmac_farcall.S).

if COSMAC_BANKING

config COSMAC_BANK_PORT
	int "Bank latch output port"
	default 1
	range 1 5
	---help---
		N of the OUT N instruction that writes the bank latch.  Ports 6 and
		7 belong to the sim1802 I/O controller.

config COSMAC_BANK_COUNT
	int "Number of 16 KiB banks"
	default 8
	range 1 256
	---help---
		Banks available to the placement tool.  The ROM image is the 32 KiB
		fixed part followed by this many banks.

config COSMAC_BRS_DEPTH
	int "Bank return stack depth"
	default 24
	range 1 255
	---help---
		Maximum nesting of far calls per thread (3 bytes of RAM each per
		thread).  Overflow causes a PANIC.  NSH's ps nests 18 far calls
		on sim1802; the depth needed also depends on code placement, so
		keep a margin.

endif # COSMAC_BANKING

endif # ARCH_COSMAC
